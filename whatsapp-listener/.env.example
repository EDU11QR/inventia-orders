# =========================================================
# EJEMPLO DE VARIABLES DE ENTORNO DEL LISTENER
# copiar a .env (ese archivo NO se sube al repositorio)
#
# npm start carga automáticamente este archivo con
# node --env-file=.env
# =========================================================

# Clave compartida con el backend para POST /api/pedidos.
# Debe ser EXACTAMENTE la misma que WHATSAPP_API_KEY del backend
WHATSAPP_API_KEY=clave-compartida-con-el-backend

# Puerto de la API local del listener (opcional, default 3001)
# WHATSAPP_LISTENER_PORT=3001
